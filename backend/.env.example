# PostgreSQL Database Connection Details
# Replace with your actual database connection info
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user         # Your PostgreSQL username
DB_PASSWORD=your_db_password # Your PostgreSQL password
DB_DATABASE=short_url_db     # The name of the database you created

# Base URL for the backend server itself (used for constructing short URLs in responses)
# Should NOT include /api. No trailing slash.
# Example: http://localhost:3000 or https://your-deployed-backend.com
BASE_URL=http://localhost:3000

# Optional: Port the backend server should listen on (defaults to 3000 if not set)
# PORT=3000

# Optional: Set Node environment (development, production)
# NODE_ENV=development