# Environment variables for the Vue.js frontend (must start with VITE_)

# Full URL where the backend API can be reached by the frontend (no trailing slash)
# For local development, this usually points to your local backend server.
# For production, this points to your deployed backend API URL.
VITE_API_BASE_URL=http://localhost:3000/api

# Base URL used for the redirect links generated by the frontend
# (e.g., for QR codes, displaying full short links).
# Usually the same as the backend's BASE_URL for local dev.
# For production, this is your main application domain where short codes are handled.
# No trailing slash.
VITE_APP_BASE_REDIRECT_URL=http://localhost:3000